rules_version = '2';

// TopSkill: every Firestore read and write goes through the backend (Admin SDK / ADC),
// which bypasses these rules. Browsers never talk to Firestore directly, so deny everything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
