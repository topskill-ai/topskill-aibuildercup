# TopSkill web — local development values (SPEC §4.3).
# Copy to web/.env.local (git-ignored). Production values are the code defaults in src/lib/config.ts,
# so a build without any env file targets prod with every dev switch off.

# Backend base URL (the browser calls Cloud Run / the local backend directly; no proxy).
VITE_API_BASE=http://127.0.0.1:8000

# Public Firebase web config for project top-skill (safe to commit).
VITE_FIREBASE_API_KEY=AIzaSyBINjnUKFWfLiSPREGBXUFx0xX8Z9-BHA0
VITE_FIREBASE_AUTH_DOMAIN=top-skill.firebaseapp.com
# Must equal the backend FIRESTORE_PROJECT: demo-topskill with the Auth emulator, else top-skill.
VITE_FIREBASE_PROJECT_ID=demo-topskill
VITE_FIREBASE_APP_ID=1:920441209758:web:3e9d36df86419f88748c8f

# 1 = connect Firebase Auth to the local emulator.
VITE_USE_AUTH_EMULATOR=1
# Auth emulator origin (only read when VITE_USE_AUTH_EMULATOR=1).
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# 1 = show "Developer login" and send X-Dev-* headers instead of a Bearer token (backend AUTH_DEV_BYPASS).
VITE_DEV_AUTH=1

# 1 = show "Continue with Google" (needs the provider enabled in the Firebase console).
VITE_GOOGLE_SIGNIN=0

# Dev server port (lanes running in parallel use their own port).
VITE_PORT=5173
