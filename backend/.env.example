# TopSkill backend — development values (SPEC §4.1). Copy to backend/.env (git-ignored).
# Code defaults are prod-safe; this file opts a local process into dev mode.
#
# Local-only gotchas:
# - gRPC (Firestore against real GCP) ignores HTTPS_PROXY; export grpc_proxy=http://127.0.0.1:6152 when the
#   backend talks to real Firestore from the laptop. Not needed with the emulator or on Cloud Run.
# - Firebase emulators need Java >= 21:
#   export JAVA_HOME=/opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home; export PATH=$JAVA_HOME/bin:$PATH
# - httpx clients that call 127.0.0.1 use trust_env=False (the local proxy would swallow loopback calls).
# - GEMINI_API_KEY is only used by the knowledge backend (KNOWLEDGE_BACKEND=file_search). Fill it locally with:
#   gcloud secrets versions access latest --secret gemini-api-key --project top-skill
#   Everything else uses Vertex AI via ADC (gcloud auth application-default login).

ENV=dev
APP_VERSION=dev
LOG_LEVEL=INFO

GOOGLE_CLOUD_PROJECT=top-skill
FIRESTORE_PROJECT=demo-topskill
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

AUTH_DEV_BYPASS=true

STORAGE_BACKEND=local
GCS_BUCKET=top-skill-files
LOCAL_STORAGE_DIR=.data/blobs

KNOWLEDGE_BACKEND=local
GEMINI_API_KEY=
MODEL_FILE_SEARCH=gemini-3.1-flash-lite
MODEL_FILE_SEARCH_FALLBACK=gemini-3.8-flash
RAG_TOP_K=4

MODEL_CHAT=gemini-3.8-flash
MODEL_CHAT_FALLBACK=gemini-3-flash-preview
MODEL_DRAFT=gemini-3.8-flash
MODEL_DRAFT_FALLBACK=gemini-3-flash-preview
MODEL_DRAFT_PRO=gemini-3.1-pro-preview
MODEL_DRAFT_PRO_FALLBACK=gemini-2.5-pro
MODEL_EXTRACT=gemini-3.8-flash
MODEL_EXTRACT_FALLBACK=gemini-3-flash-preview
MODEL_ASSISTANT=gemini-3.8-flash
MODEL_ASSISTANT_FALLBACK=gemini-3-flash-preview
MODEL_IMAGE=gemini-3.1-flash-image
MODEL_IMAGE_FALLBACK=gemini-2.5-flash-image
CHAT_MODEL_ALLOWLIST=gemini-3.8-flash,gemini-3-flash-preview,gemini-3.1-pro-preview,gemini-2.5-pro
LLM_MODE=live

CREATOR_REVENUE_SHARE_BP=8000
SIGNUP_GRANT_CENTS=10000
DEMO_TOPUP_CENTS=5000
DEMO_TOPUP_DAILY_LIMIT=5

PUBLIC_API_BASE=http://127.0.0.1:8000
PUBLIC_WEB_BASE=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=

# Dev/test only: an Ed25519 PEM is auto-generated here if missing. Prod uses MANDATE_SIGNING_KEY (Secret Manager).
MANDATE_KEY_FILE=.data/mandate_ed25519.pem
MANDATE_KID=dev-1
MANDATE_MAX_TTL_MINUTES=1440
MANDATE_MAX_BUDGET_CENTS=100000

TURN_IDLE_TIMEOUT_S=120
TURN_TOTAL_TIMEOUT_S=300
MAX_CONCURRENT_TURNS=40
MAX_ROUNDS_PER_CONVERSATION=30
MAX_LLM_CALLS_PER_TURN=8
DRAFT_RATE_LIMIT_PER_HOUR=30
AVATAR_RATE_LIMIT_PER_HOUR=20
A2A_CALL_TIMEOUT_S=120

# P2 guard: Model Armor (SPEC 18.1). Off in dev by default; set GUARD_BACKEND=model_armor to screen with the
# real template through ADC (needs roles/modelarmor.user; first call after start ~2 s, then ~0.4 s).
GUARD_BACKEND=off
GUARD_PROJECT=top-skill
GUARD_LOCATION=asia-southeast1
GUARD_TEMPLATE=topskill-public
GUARD_TIMEOUT_S=3

# Tracing (P2, SPEC §18.3): OpenTelemetry -> Cloud Trace (project top-skill) via ADC. Off locally by default;
# set TRACING_ENABLED=true to send a dev run's spans to Cloud Trace (needs gcloud ADC with trace write access).
TRACING_ENABLED=false
TRACE_SAMPLE_RATIO_TURNS=1.0
TRACE_SAMPLE_RATIO=1.0
TRACE_SAMPLE_RATIO_HEALTH=0.01
TRACE_CAPTURE_CONTENT=false

# Ask your data (P2, SPEC 18 analytics). Off by default. Outside prod the prod dataset `topskill_analytics` is
# refused; use the dev dataset (it receives a copy of whatever your local Firestore emulator holds).
ANALYTICS_ENABLED=false
ANALYTICS_DATASET=topskill_analytics_dev
ANALYTICS_LOCATION=asia-southeast1
MODEL_ANALYTICS=gemini-3.8-flash
MODEL_ANALYTICS_FALLBACK=gemini-3-flash-preview
